<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
		PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
		"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zywl.app.defaultx.mapper.DicVipMapper">

	<resultMap id="BaseResultMap" type="com.zywl.app.base.bean.DicVip">
		<id     column="vip_type"        property="vipType"/>
		<result column="name"            property="name"/>
		<result column="duration_days"   property="durationDays"/>
		<result column="price"           property="price"/>
		<result column="capital_type_id" property="capitalTypeId"/>
		<result column="benefit_text"    property="benefitText"/>
		<result column="daily_reward"    property="dailyReward" jdbcType="VARCHAR"/>
		<result column="card_item_id"    property="cardItemId"/>
		<result column="status"          property="status"/>
		<result column="create_time"     property="createTime"/>
		<result column="update_time"     property="updateTime"/>
	</resultMap>

	<sql id="Base_Column_List">
		vip_type,
        name,
        duration_days,
        price,
        capital_type_id,
        benefit_text,
        daily_reward,
        card_item_id,
        status,
        create_time,
        update_time
	</sql>

	<select id="findAll" resultMap="BaseResultMap">
		select
		<include refid="Base_Column_List"/>
		from dic_vip
		where status = 1
		order by vip_type asc
	</select>

	<select id="selectByPrimaryKey" parameterType="long" resultMap="BaseResultMap">
		select
		<include refid="Base_Column_List"/>
		from dic_vip
		where vip_type = #{id}
	</select>

	<select id="countByConditions" parameterType="map" resultType="int">
		select count(1)
		from dic_vip
		<where>
			<if test="vipType != null">
				and vip_type = #{vipType}
			</if>
			<if test="status != null">
				and status = #{status}
			</if>
		</where>
	</select>

	<!-- 查询所有VIP配置（含禁用状态，后台管理用） -->
	<select id="findAllForAdmin" resultMap="BaseResultMap">
		select
		<include refid="Base_Column_List"/>
		from dic_vip
		order by vip_type asc
	</select>

	<!-- 后台更新VIP配置 -->
	<update id="updateVip" parameterType="com.zywl.app.base.bean.DicVip">
		update dic_vip
		<set>
			<if test="name != null">name = #{name},</if>
			<if test="durationDays != null">duration_days = #{durationDays},</if>
			<if test="price != null">price = #{price},</if>
			<if test="capitalTypeId != null">capital_type_id = #{capitalTypeId},</if>
			<if test="benefitText != null">benefit_text = #{benefitText},</if>
			<if test="dailyReward != null">daily_reward = #{dailyReward},</if>
			<if test="cardItemId != null">card_item_id = #{cardItemId},</if>
			<if test="status != null">status = #{status},</if>
			<if test="updateTime != null">update_time = #{updateTime},</if>
		</set>
		where vip_type = #{vipType}
	</update>

</mapper>