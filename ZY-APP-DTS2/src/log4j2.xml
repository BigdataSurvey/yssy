<?xml version="1.0" encoding="UTF-8"?>
<configuration monitorInterval="30">
	<properties>
		<!-- File base path -->
		<property name="LOG_HOME">/data/logs/dts5001</property>
		<!-- App server name -->
		<property name="SERVER_NAME">dts</property>
	</properties>
	<appenders>
		<Console name="console" target="SYSTEM_OUT">
			<!--只输出level及以上级别的信息（onMatch），其他的直接拒绝（onMismatch）-->
			<ThresholdFilter level="DEBUG" onMatch="ACCEPT" onMismatch="DENY"/>
			<PatternLayout pattern="[%-5p] [%d{HH:mm:ss}] %c - %m%n" />
		</Console>

		<RollingFile name="RollingFile" fileName="${LOG_HOME}/${SERVER_NAME}_log"
					 filePattern="${LOG_HOME}/${SERVER_NAME}/%d{yyyy-MM-dd}.log" >

			<PatternLayout pattern="[%-5p] [%d{HH:mm:ss:SSS}] %c - %m%n" />
			<Policies>
				<TimeBasedTriggeringPolicy modulate="true" interval="1"/>
			</Policies>
		</RollingFile>
	</appenders>
	<!--只有定义了logger并引入的appender，appender才会生效 -->
	<loggers>
		<!-- 根级别不要 debug -->
		<root level="info">
			<appender-ref ref="console"/>
			<appender-ref ref="RollingFile"/>
		</root>

		<!-- MyBatis / Spring-MyBatis 统统压下去 -->
		<logger name="org.mybatis" level="warn"/>
		<logger name="org.mybatis.spring" level="warn"/>
		<logger name="org.mybatis.spring.SqlSessionUtils" level="error"/>

		<!-- druid 连接池刷屏也压掉 -->
		<logger name="druid.sql" level="error"/>
		<logger name="com.alibaba.druid" level="error"/>

		<!-- ✅ 关键：mapper 包不要 debug -->
		<logger name="com.zywl.app.defaultx.mapper" level="info"/>
	</loggers>
</configuration>